# ---- LLM providers (free tiers) ----
# Primary chat/reasoning provider: groq | gemini | xai | mock (offline, deterministic; for tests/demos)
ARCHON_LLM_PROVIDER=groq
# Fallback chain (D-018): tried in order when the primary fails or times out; links without a key are skipped.
ARCHON_LLM_FALLBACKS=groq:qwen/qwen3.8-27b,gemini,gemini:gemini-3.5-flash-lite
ARCHON_LLM_TIMEOUT=60
# Which provider to use for embeddings: gemini | local
ARCHON_EMBED_PROVIDER=gemini
# Embedding pace (D-021): texts and estimated tokens per minute; lowered automatically on quota errors
ARCHON_EMBED_RPM=90
ARCHON_EMBED_TPM=20000

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3.x thinks before answering: low | medium | high | off
GEMINI_THINKING_LEVEL=low
GEMINI_EMBED_MODEL=gemini-embedding-001

# Groq key (OpenAI-compatible, free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Free tier tokens/minute per Groq model; prompts too large for it go straight to the next link
GROQ_TPM_LIMIT=8000

# xAI Grok key (OpenAI-compatible): https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# ---- Storage ----
# Default: zero-setup SQLite. For Postgres run `docker compose up -d` and use:
# DATABASE_URL=postgresql+asyncpg://archon:archon@localhost:5432/archon
DATABASE_URL=sqlite+aiosqlite:///./data/archon.db

# Where cloned repositories are stored
ARCHON_WORKSPACE=./workspace

# ---- API ----
# Optional shared secret. When set, clients must send X-API-Key (the web app reads NEXT_PUBLIC_ARCHON_API_KEY).
ARCHON_API_KEY=
ARCHON_API_HOST=127.0.0.1
ARCHON_API_PORT=8001
ARCHON_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ---- Web (apps/web/.env.local) ----
NEXT_PUBLIC_ARCHON_API_URL=http://127.0.0.1:8001
NEXT_PUBLIC_ARCHON_API_KEY=
